{
  "name": "quantix-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces",
    "verify": "node scripts/verify-quality.js",
    "vercel:pull:preview": "npx vercel@latest pull --cwd frontend --yes --environment=preview",
    "vercel:pull:prod": "npx vercel@latest pull --cwd frontend --yes --environment=production",
    "deploy:frontend:preview": "npx vercel@latest pull --cwd frontend --yes --environment=preview && npx vercel@latest build --cwd frontend && npx vercel@latest deploy --cwd frontend --prebuilt",
    "deploy:frontend:prod": "npx vercel@latest pull --cwd frontend --yes --environment=production && npx vercel@latest build --cwd frontend --prod && npx vercel@latest deploy --cwd frontend --prebuilt --prod",
    "render:validate": "./scripts/render-validate.sh",
    "render:services": "./scripts/render-services.sh",
    "render:deploys": "./scripts/render-deploys.sh",
    "render:deploy": "./scripts/render-deploy.sh",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "postinstall": "npm run build -w shared",
    "build-storybook": "npm run build-storybook -w frontend",
    "chromatic": "npx chromatic --project-token=chpt_d8e726f28427857"
  },
  "keywords": [
    "cpu-scheduling",
    "visualizer",
    "react",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@chromatic-com/storybook": "3.2.4",
    "@storybook/addon-a11y": "8.6.15",
    "@storybook/addon-docs": "8.6.15",
    "@storybook/addon-essentials": "8.6.15",
    "@storybook/addon-interactions": "8.6.15",
    "@storybook/addon-links": "8.6.15",
    "@storybook/addon-onboarding": "8.6.15",
    "@storybook/blocks": "8.6.15",
    "@storybook/core": "8.6.15",
    "@storybook/react": "8.6.15",
    "@storybook/react-vite": "8.6.15",
    "chromatic": "^15.0.0",
    "eslint-plugin-storybook": "^0.11.2",
    "prettier": "^3.0.0",
    "storybook": "8.6.15"
  }
}
